---
import BaseLayout from '../layouts/BaseLayout.astro';
import Capabilities from './sections/Capabilities.astro';
import Commitments from './sections/Commitments.astro';
import Company from './sections/Company.astro';
import Contact from './sections/Contact.astro';
import Hero from './sections/Hero.astro';
import Services from './sections/Services.astro';
import { t, type Locale } from '../i18n';
import { organizationSchema } from '../lib/structured-data';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);
---

<BaseLayout
  locale={locale}
  page="home"
  title={dict.meta.title}
  description={dict.meta.description}
  structuredData={organizationSchema(locale)}
>
  <Hero locale={locale} />
  <Services locale={locale} />
  <Company locale={locale} />
  <Capabilities locale={locale} />
  <Commitments locale={locale} />
  <Contact locale={locale} />
</BaseLayout>
