---
/**
 * Inline brand lockup generated by scripts/build-brand.mjs.
 * Structure and wordmark use `currentColor`; the module accent uses --logo-accent.
 */
import logoSvg from '../assets/brand/logo.svg?raw';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<span class:list={['logo', className]} set:html={logoSvg} />

<style>
  .logo {
    display: inline-flex;
    --logo-accent: var(--green-500);
  }

  .logo :global(svg) {
    height: 100%;
    width: auto;
  }
</style>
