---
import Icon from './Icon.astro';
import { company } from '../config/company';
import { t, type Locale } from '../i18n';
import { whatsappHref } from '../lib/whatsapp';

interface Props {
  locale: Locale;
}

const dict = t(Astro.props.locale);
---

<a
  class="wa-float"
  href={whatsappHref(company.whatsapp, dict.contact.whatsappMessage)}
  target="_blank"
  rel="noopener"
  data-wa-float
>
  <Icon name="whatsapp" size={26} />
  <span class="wa-label">{dict.nav.whatsapp}</span>
  <span class="visually-hidden">
    {dict.a11y.whatsappFloat} ({dict.a11y.opensWhatsApp})
  </span>
</a>

<script>
  // Hide the floating button while the hero or the contact section (both with their own
  // WhatsApp CTA) or the mobile menu is on screen, so it never duplicates those actions.
  const button = document.querySelector<HTMLElement>('[data-wa-float]');
  const targets = document.querySelectorAll('[data-hero], [data-contact-section]');
  if (button && targets.length && 'IntersectionObserver' in window) {
    const visible = new Set<Element>();
    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) visible.add(entry.target);
        else visible.delete(entry.target);
      }
      button.classList.toggle('is-hidden', visible.size > 0);
    });
    targets.forEach((el) => observer.observe(el));
  }
</script>

<style>
  .wa-float {
    position: fixed;
    right: max(1rem, env(safe-area-inset-right));
    bottom: max(1rem, env(safe-area-inset-bottom));
    z-index: 40;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    height: 56px;
    padding: 0 15px;
    border-radius: 999px;
    background: var(--green-700);
    color: var(--white);
    font-weight: 600;
    text-decoration: none;
    box-shadow:
      0 10px 24px -8px rgb(7 20 35 / 0.45),
      0 0 0 1px rgb(255 255 255 / 0.12) inset;
    transition:
      background-color 0.2s var(--ease),
      opacity 0.25s var(--ease),
      transform 0.25s var(--ease),
      visibility 0.25s;
  }

  .wa-float:hover {
    background: var(--green-800);
  }

  .wa-float:focus-visible {
    outline-color: var(--navy-900);
    box-shadow: 0 0 0 3px var(--white);
  }

  .wa-label {
    display: none;
    padding-right: 4px;
  }

  @media (min-width: 1024px) {
    .wa-float {
      right: 1.5rem;
      bottom: 1.5rem;
      padding-inline: 18px 20px;
    }

    .wa-label {
      display: inline;
    }
  }

  .wa-float:global(.is-hidden),
  :global(body.menu-open) .wa-float {
    opacity: 0;
    visibility: hidden;
    transform: translateY(12px);
  }
</style>
