---
import Icon from '../Icon.astro';
import { t, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);
---

<section
  id={dict.anchors.capabilities}
  class="section section--navy on-dark"
  aria-labelledby="capabilities-title"
>
  <div class="grid-lines" aria-hidden="true"></div>
  <div class="container">
    <header class="section-head" data-reveal>
      <div>
        <p class="eyebrow">{dict.capabilities.eyebrow}</p>
        <h2 id="capabilities-title">{dict.capabilities.title}</h2>
      </div>
      <p class="lead">{dict.capabilities.intro}</p>
    </header>

    <ol class="steps" role="list">
      {dict.capabilities.steps.map((step, i) => (
        <li class="step" data-reveal style={`--reveal-delay: ${i * 90}ms`}>
          <span class="node" aria-hidden="true" />
          <span class="step-num mono">{String(i + 1).padStart(2, '0')}</span>
          <h3>{step.title}</h3>
          <p>{step.text}</p>
        </li>
      ))}
    </ol>

    <p class="note">
      <Icon name="info" size={18} />
      <span>{dict.capabilities.note}</span>
    </p>

    <div class="audience" data-reveal>
      <h3 class="audience-title mono">{dict.capabilities.audienceTitle}</h3>
      <ul role="list">
        {dict.capabilities.audience.map((a) => (
          <li>{a}</li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .section {
    overflow: hidden;
  }

  .steps {
    position: relative;
    display: grid;
    margin: 0;
  }

  .step {
    position: relative;
    padding: 0 0 2.5rem 2.75rem;
  }

  /* Vertical connector on small screens */
  .step::before {
    content: '';
    position: absolute;
    left: 5px;
    top: 0.5rem;
    bottom: 0;
    width: 1px;
    background: var(--line-dark);
  }

  .step:last-child::before {
    display: none;
  }

  .node {
    position: absolute;
    left: 0;
    top: 0.3rem;
    width: 11px;
    height: 11px;
    background: var(--green-400);
  }

  .step-num {
    font-size: 0.8125rem;
    color: var(--green-400);
  }

  h3 {
    margin-top: 0.6rem;
    font-size: var(--step-1);
  }

  .step p {
    margin-top: 0.6rem;
    font-size: 0.9688rem;
    color: var(--on-dark-2);
    max-width: 30rem;
  }

  @media (min-width: 1000px) {
    .steps {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      column-gap: 1.5rem;
    }

    .step {
      padding: 2.25rem 0 0;
    }

    /* Horizontal connector across the steps */
    .step::before,
    .step:last-child::before {
      display: block;
      left: 0;
      right: -1.5rem;
      top: 5px;
      bottom: auto;
      width: auto;
      height: 1px;
    }

    .step:last-child::before {
      right: 0;
    }

    .node {
      top: 0;
    }
  }

  .note {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    margin-top: clamp(1rem, 3vw, 3rem);
    max-width: 44rem;
    font-size: 0.875rem;
    color: var(--on-dark-3);
  }

  .note :global(svg) {
    flex: none;
    margin-top: 0.15rem;
  }

  .audience {
    display: grid;
    gap: 1.25rem;
    margin-top: clamp(3.5rem, 7vw, 5.5rem);
    padding-top: 2rem;
    border-top: 1px solid var(--line-dark);
  }

  .audience-title {
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--green-400);
  }

  .audience ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 0;
  }

  .audience li {
    padding: 0.55rem 1rem;
    border: 1px solid var(--line-dark);
    font-size: 0.9375rem;
    color: var(--on-dark-2);
  }

  @media (min-width: 1000px) {
    .audience {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: 1.5rem;
      align-items: start;
    }

    .audience-title {
      grid-column: span 3;
      padding-top: 0.7rem;
    }

    .audience ul {
      grid-column: 4 / -1;
    }
  }
</style>
