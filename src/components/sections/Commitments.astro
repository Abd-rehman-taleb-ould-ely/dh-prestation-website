---
import Icon from '../Icon.astro';
import { t, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);

const icons = [
  'professionalism',
  'quality',
  'schedule',
  'safety',
  'flexibility',
  'collaboration',
] as const;
---

<section id={dict.anchors.commitments} class="section" aria-labelledby="commitments-title">
  <div class="container">
    <header class="section-head" data-reveal>
      <div>
        <p class="eyebrow">{dict.commitments.eyebrow}</p>
        <h2 id="commitments-title">{dict.commitments.title}</h2>
      </div>
      <p class="lead">{dict.commitments.intro}</p>
    </header>

    <ul class="items" role="list">
      {dict.commitments.items.map((item, i) => (
        <li data-reveal style={`--reveal-delay: ${(i % 3) * 80}ms`}>
          <span class="icon">
            <Icon name={icons[i]} size={28} />
          </span>
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .items {
    display: grid;
    margin: 0;
    border-top: 1px solid var(--line);
  }

  li {
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: 1.25rem;
    padding-block: 1.75rem;
    border-bottom: 1px solid var(--line);
  }

  .icon {
    grid-row: span 2;
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    background: var(--stone-50);
    color: var(--green-700);
  }

  h3 {
    font-size: var(--step-1);
    align-self: end;
  }

  p {
    margin-top: 0.4rem;
    color: var(--ink-2);
    max-width: 30rem;
  }

  @media (min-width: 700px) {
    .items {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 2rem;
    }
  }

  @media (min-width: 1100px) {
    .items {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: 3rem;
    }

    li {
      grid-template-columns: 1fr;
      align-content: start;
      padding-block: 2.25rem 2.5rem;
    }

    .icon {
      grid-row: auto;
      margin-bottom: 1.5rem;
    }

    h3 {
      align-self: start;
    }
  }
</style>
