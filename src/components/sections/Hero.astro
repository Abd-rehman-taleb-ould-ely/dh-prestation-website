---
import Icon from '../Icon.astro';
import Photo from '../Photo.astro';
import { company } from '../../config/company';
import { CORE_SERVICES, serviceAnchor } from '../../data/services';
import { sectionHref, t, type Locale } from '../../i18n';
import { whatsappHref } from '../../lib/whatsapp';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);
---

<section class="hero on-dark" aria-labelledby="hero-title" data-hero>
  <div class="media">
    <Photo id="hero" locale={locale} sizes="100vw" widths={[768, 1280, 1920, 2560]} priority />
  </div>
  <div class="shade" aria-hidden="true"></div>
  <div class="grid-lines" aria-hidden="true"></div>

  <div class="container content">
    <div class="copy">
      <p class="eyebrow">{dict.hero.eyebrow}</p>
      <h1 id="hero-title">{dict.hero.title}</h1>
      <p class="lead">{dict.hero.lead}</p>
      <div class="ctas">
        <a
          class="btn btn--primary btn--lg"
          href={whatsappHref(company.whatsapp, dict.contact.whatsappMessage)}
          target="_blank"
          rel="noopener"
        >
          <Icon name="whatsapp" />
          {dict.hero.primaryCta}
          <span class="visually-hidden">({dict.a11y.opensWhatsApp})</span>
        </a>
        <a class="btn btn--ghost btn--lg" href={sectionHref(locale, 'services')}>
          {dict.hero.secondaryCta}
          <Icon name="arrowDown" />
        </a>
      </div>
      <p class="audience">
        <span class="mono">{dict.hero.audienceLabel}</span>
        <span>{dict.hero.audience.join(' · ')}</span>
      </p>
    </div>

    <nav class="index" aria-label={dict.hero.indexLabel}>
      <ol role="list">
        {CORE_SERVICES.map((s, i) => (
          <li>
            <a href={`#${serviceAnchor(s.id)}`}>
              <span class="mono">0{i + 1}</span>
              <span>{dict.services.items[s.id].short}</span>
            </a>
          </li>
        ))}
      </ol>
    </nav>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    display: flex;
    min-height: max(620px, min(100svh, 940px));
    padding-top: var(--header-h);
    background: var(--navy-950);
    overflow: hidden;
  }

  .media,
  .shade {
    position: absolute;
    inset: 0;
    z-index: -2;
  }

  .media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .shade {
    z-index: -1;
    background:
      linear-gradient(180deg, rgb(7 20 35 / 0.55) 0%, rgb(7 20 35 / 0) 22%),
      linear-gradient(
        0deg,
        rgb(7 20 35 / 0.92) 0%,
        rgb(7 20 35 / 0.35) 45%,
        rgb(7 20 35 / 0.2) 100%
      );
  }

  @media (min-width: 900px) {
    .shade {
      background:
        linear-gradient(
          90deg,
          rgb(7 20 35 / 0.9) 0%,
          rgb(7 20 35 / 0.74) 36%,
          rgb(7 20 35 / 0.2) 68%,
          rgb(7 20 35 / 0.05) 100%
        ),
        linear-gradient(0deg, rgb(7 20 35 / 0.85) 0%, rgb(7 20 35 / 0) 34%);
    }
  }

  .grid-lines {
    z-index: -1;
  }

  .content {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: clamp(2.5rem, 6vh, 4.5rem);
    padding-block: clamp(3rem, 8vh, 6rem) clamp(2rem, 5vh, 3rem);
  }

  .copy {
    max-width: 50rem;
  }

  h1 {
    margin-top: 1.5rem;
    max-width: 17ch;
  }

  .lead {
    margin-top: 1.5rem;
    max-width: 40rem;
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.25rem;
  }

  @media (max-width: 479px) {
    .ctas .btn {
      width: 100%;
    }
  }

  .audience {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.85rem;
    margin-top: 2rem;
    font-size: 0.9375rem;
    color: var(--on-dark-2);
  }

  .audience .mono {
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--green-400);
    line-height: 1.9;
  }

  .index {
    display: none;
  }

  @media (min-width: 900px) {
    .index {
      display: block;
    }

    .index ol {
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      margin: 0;
      border-top: 1px solid var(--line-dark);
    }

    .index a {
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
      height: 100%;
      padding: 1.1rem 1.25rem 0.25rem 0;
      font-size: 0.9375rem;
      font-weight: 500;
      line-height: 1.35;
      color: var(--on-dark-2);
      text-decoration: none;
      border-top: 2px solid transparent;
      margin-top: -1px;
      transition:
        color 0.2s var(--ease),
        border-color 0.2s var(--ease);
    }

    .index a:hover {
      color: var(--white);
      border-top-color: var(--green-400);
    }

    .index .mono {
      font-size: 0.75rem;
      color: var(--green-400);
    }
  }
</style>
